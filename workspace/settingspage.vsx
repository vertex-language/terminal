package workspace

import (
    "icons/lucide"
    "ui/icon"
)

// The settings tab's page: a sidebar of pages (back to the terminal, a
// search box, the settings, the profiles, the JSON file) beside the page,
// a title over cards of rows, each a setting and its control.

/// A sidebar page's icon.
@MainActor
func NavIcon(name: string) -> Element {
    switch name {
    case "rocket": return icon.Icon(of: lucide.Rocket, size: 18)
    case "pointer": return icon.Icon(of: lucide.MousePointerClick, size: 18)
    case "sun": return icon.Icon(of: lucide.SunMoon, size: 18)
    case "palette": return icon.Icon(of: lucide.Palette, size: 18)
    case "keyboard": return icon.Icon(of: lucide.Keyboard, size: 18)
    case "layers": return icon.Icon(of: lucide.Layers, size: 18)
    case "json": return icon.Icon(of: lucide.FileJson, size: 18)
    default: return icon.Icon(of: lucide.SquareTerminal, size: 18)
    }
}

/// The settings tab in the tab bar.
@MainActor
func SettingsTabItem(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className={ui.SettingsShown ? "tab settings-tab active" : "tab settings-tab"} title="Settings"
             onPointerDown={e in
                 if e.Button == 1 { c.CloseSettingsTab() }
             }
             onClick={_ in c.OpenSettingsTab()}>
            {if ui.SettingsShown {
                <div className="foot left sfoot">
                    <svg width="10" height="10" viewBox="0 0 10 10"><path d="M10 0 L10 10 L0 10 C5.5 10 10 5.5 10 0 Z" fill="currentColor" /></svg>
                </div>
            }}
            {if ui.SettingsShown {
                <div className="foot right sfoot">
                    <svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 0 L0 10 L10 10 C4.5 10 0 5.5 0 0 Z" fill="currentColor" /></svg>
                </div>
            }}
            <span className="favicon">{icon.Icon(of: lucide.Settings, size: 15)}</span>
            <span className="label">Settings</span>
            <div className="close" role="button" title="Close settings" onPointerDown={e in e.StopPropagation()} onClick={e in
                e.StopPropagation()
                c.CloseSettingsTab()
            }>
                <svg width="10" height="10" viewBox="0 0 10 10"><path d="M1.3 0.5 L9.5 8.7 L8.7 9.5 L0.5 1.3 Z M8.7 0.5 L9.5 1.3 L1.3 9.5 L0.5 8.7 Z" fill="currentColor" /></svg>
            </div>
        </div>
    )
}

@MainActor
func NavItem(c: Controller, p: SettingsPageInfo) -> Element {
    let ui = c.ui
    return (
        <div className={ui.SettingsPage == p.ID && ui.SettingsQuery.isEmpty ? "snavitem active" : "snavitem"}
             onClick={_ in
                 ui.SettingsQuery = ""
                 ui.SettingsPage = p.ID
             }>
            {NavIcon(name: p.Icon)}
            <span className="snavlabel">{p.Title}</span>
        </div>
    )
}

/// A text field: what is typed is written on Enter, or when it loses the
/// keyboard.
@MainActor
func SettingField(c: Controller, r: SettingRow) -> Element {
    let (draft, setDraft) = useState(r.Value)
    return (
        <input className="sfield" value={r.Value} spellcheck="false"
               onInput={e in setDraft(e.Value)}
               onKeyDown={e in
                   e.StopPropagation()
                   if e.Key == "Enter" && draft != r.Value { r.Set(draft) }
                   if e.Key == "Escape" { c.ui.SettingsRev += 1 }
               }
               onBlur={_ in if draft != r.Value { r.Set(draft) }} />
    )
}

@MainActor
func SettingNumber(c: Controller, r: SettingRow) -> Element {
    let (draft, setDraft) = useState(r.Value)
    return (
        <div className="stepper" onClick={e in e.StopPropagation()}>
            <div className="sstep" role="button" title="Less" onClick={_ in c.stepNumber(r, -1)}>−</div>
            <input className="snum" value={r.Value}
                   onInput={e in setDraft(e.Value)}
                   onKeyDown={e in
                       e.StopPropagation()
                       if e.Key == "Enter" { c.typedNumber(r, draft) }
                       if e.Key == "ArrowUp" { c.stepNumber(r, 1) }
                       if e.Key == "ArrowDown" { c.stepNumber(r, -1) }
                   }
                   onBlur={_ in if draft != r.Value { c.typedNumber(r, draft) }} />
            <div className="sstep" role="button" title="More" onClick={_ in c.stepNumber(r, 1)}>+</div>
        </div>
    )
}

/// One setting: its title and what it does, and its control.
@MainActor
func SettingLine(c: Controller, r: SettingRow) -> Element {
    let clickable = r.Kind == "toggle" || r.Kind == "choice" || r.Kind == "scheme"
    return (
        <div className={"srow" + (clickable ? " clickable" : "") + (r.First ? " first" : "")}
             onClick={e in
                 switch r.Kind {
                 case "toggle": r.Set(r.On ? "false" : "true")
                 case "choice": c.openChoice(r, x: e.X - 160, y: e.Y + 12)
                 case "scheme": r.Set("")
                 default: break
                 }
             }>
            <div className="stext">
                <div className="stitle">{r.Title}</div>
                {if !r.Detail.isEmpty { <div className="sdetail">{r.Detail}</div> }}
                {if r.Kind == "scheme" {
                    <div className="swatches">
                        {r.Colors.map { col in <span className="sw" style={Style(background: col)}></span> }}
                    </div>
                }}
            </div>
            {if r.Kind == "toggle" {
                <div className={r.On ? "switch on" : "switch"} role="switch"><div className="knob"></div></div>
            }}
            {if r.Kind == "choice" {
                <div className="schoice">
                    <span className="svalue">{r.Value}</span>
                    {icon.Icon(of: lucide.ChevronsUpDown, size: 15)}
                </div>
            }}
            {if r.Kind == "text" { <SettingField c={c} r={r} /> }}
            {if r.Kind == "number" { <SettingNumber c={c} r={r} /> }}
            {if r.Kind == "keys" && !r.Value.isEmpty { <span className="skeys">{r.Value}</span> }}
            {if r.Kind == "scheme" && r.On { <span className="scheck">{icon.Icon(of: lucide.Check, size: 17)}</span> }}
            {if r.Kind == "scheme" && !r.On { <span className="schev">{icon.Icon(of: lucide.ChevronRight, size: 17)}</span> }}
        </div>
    )
}

@MainActor
func SettingCard(c: Controller, g: SettingGroup) -> Element {
    return (
        <section className="sgroup">
            <h2>{g.Title}</h2>
            <div className="scard">
                {g.Rows.map { r in <SettingLine key={r.ID} c={c} r={r} /> }}
            </div>
        </section>
    )
}

/// The page itself: its title and its cards, drawn again when the page,
/// the search, or the settings change.
@MainActor
func SettingsBody(c: Controller, page: string, query: string, rev: int) -> Element {
    let groups = c.SettingsGroups(page: page, query: query)
    return (
        <div className="scontent">
            <h1>{query.isEmpty ? c.SettingsTitle(page) : "Search results"}</h1>
            {if page.hasPrefix("profile:") && query.isEmpty {
                <div className="ssub">{page == "profile:" ? "Every profile starts from these; a profile's own settings win." : "A profile: what a tab runs, and how it looks."}</div>
            }}
            {groups.map { g in <SettingCard key={g.ID} c={c} g={g} /> }}
            {if groups.isEmpty { <div className="sempty">No settings match “{query}”</div> }}
        </div>
    )
}

/// The settings tab's page, over the terminal.
@MainActor
func SettingsPage(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="settings" tabindex="0" autofocus onKeyDown={e in c.SettingsKey(e)}>
            <aside className="snav">
                <div className="sback" role="button" onClick={_ in c.ShowTerminal()}>
                    {icon.Icon(of: lucide.ArrowLeft, size: 18)}
                    <span>Back to terminal</span>
                </div>
                <div className="ssearch">
                    {icon.Icon(of: lucide.Search, size: 16)}
                    <input className="squery" placeholder="Search" value={ui.SettingsQuery} spellcheck="false"
                           onInput={e in ui.SettingsQuery = e.Value}
                           onKeyDown={e in
                               e.StopPropagation()
                               if e.Key == "Escape" { ui.SettingsQuery = "" }
                           } />
                </div>
                <div className="sheading">Settings</div>
                {c.SettingsPages.map { p in <NavItem key={p.ID} c={c} p={p} /> }}
                <div className="sheading">Profiles</div>
                {c.LiveProfilePages().map { p in <NavItem key={p.ID} c={c} p={p} /> }}
                <div className="snavitem" onClick={_ in c.RunCommand("openSettings")} title={c.settingsFile}>
                    {NavIcon(name: "json")}
                    <span className="snavlabel">Open JSON file</span>
                    <span className="sout">{icon.Icon(of: lucide.ArrowUpRight, size: 15)}</span>
                </div>
            </aside>
            <main className="smain">
                {SettingsBody(c: c, page: ui.SettingsPage, query: ui.SettingsQuery, rev: ui.SettingsRev)}
            </main>
        </div>
    )
}
