// Package workspace is the terminal app's window: a tab bar over a
// terminal surface, each tab a shell under a pseudo-terminal (os/pty)
// whose screen vt keeps and view draws. cmd/terminal runs it in a window;
// cmd/check-ui mounts it headless and types into it.
//
//     app.Run(title: "Terminal") { <workspace.TerminalWindow /> }
package workspace

import (
    "os/env"
    "terminal/view"
    "terminal/vt"
    "ui/app"
    "ui/component"
    "ui/state"
    "ui/viewport"
    "ui/window"
    "web/dom"
    "web/html"
)

/// What the window holds: the tabs, the one terminal view that shows
/// the tab in front, and what keys, the pointer and the wheel do to it.
@MainActor
public final class Controller {
    let ws = Workspace()
    let renderer = view.Renderer()
    var handle: viewport.Handle? = nil
    var surfaceNode: component.Ref = nil
    var focused = false
    var blinkOn = true
    var blinkEpoch = 0
    /// The next text event is a key already sent (Option as Meta).
    var swallowText = false
    let optionAsMeta = (env.Get("TERMINAL_OPTION_AS_META") ?? "") == "1"
    // The pointer.
    var selecting = false
    var anchorColumn = 0
    var anchorLine = 0
    var mouseButton = -1
    /// The press in progress is the program's (mouse reporting), not a
    /// selection.
    var mouseReported = false
    var wheel: float32 = 0
    // The last frame's geometry.
    var scale: float32 = 2
    var gridColumns = 80
    var gridRows = 24
    var shownTheme = ""

    public init() {}

    var current: Shell? { return ws.Current?.shell }

    // MARK: - Reading it (for a host, or a test)

    /// How many tabs are open.
    public var TabCount: int { return ws.Tabs.count }

    /// The titles of the tabs, in order, and which is in front.
    public var TabTitles: [string] { return ws.Tabs.map { $0.Title } }
    public var ActiveIndex: int { return ws.Index(of: ws.Active) ?? -1 }

    /// The text of the screen of the tab in front.
    public func ScreenText() -> string {
        return current?.term.ScreenText() ?? ""
    }

    /// The text selected in the tab in front, or "".
    public func SelectedText() -> string {
        guard let shell = current, let sel = shell.selection?.Ordered, !sel.IsEmpty else { return "" }
        return shell.term.Text(fromColumn: sel.StartColumn, line: sel.StartLine, toColumn: sel.EndColumn, line: sel.EndLine)
    }

    /// The size of the terminal in front, in cells.
    public var GridSize: (Columns: int, Rows: int) {
        guard let t = current?.term else { return (Columns: 0, Rows: 0) }
        return (Columns: t.Columns, Rows: t.Rows)
    }

    func redraw() {
        handle?.Invalidate()
    }

    /// Gives the terminal surface the keyboard.
    func focusSurface() {
        if let n = surfaceNode { component.Focus(n) }
    }

    // MARK: - Tabs

    func NewTab() {
        NewTab(dir: current?.Directory)
    }

    func NewTab(dir: string?) {
        let id = ws.next
        ws.next += 1
        let shell = Shell(columns: gridColumns, rows: gridRows)
        let tab = Tab(id: id, shell: shell)
        shell.owner = self
        shell.tabID = id
        ws.Tabs.append(tab)
        Select(id)
        shell.Start(dir: dir)
        tab.UpdateTitle()
        app.SetTitle(tab.Title)
    }

    /// A tab's shell wrote something.
    func ShellOutput(_ id: int) {
        guard let i = ws.Index(of: id) else { return }
        let t = ws.Tabs[i]
        t.UpdateTitle()
        if ws.Active == id {
            redraw()
            app.SetTitle(t.Title)
        } else if t.shell.term.Bells != t.seenBells {
            t.Bell = true
        }
        t.seenBells = t.shell.term.Bells
    }

    /// A tab's shell ended: its tab closes.
    func ShellExited(_ id: int) {
        Close(id)
    }

    func Select(_ id: int) {
        if ws.Active != id {
            ws.Active = id
            if let i = ws.Index(of: id) { ws.Tabs[i].Bell = false }
            renderer.Invalidate()
            if let t = ws.Current { app.SetTitle(t.Title) }
        }
        blinkOn = true
        redraw()
        focusSurface()
    }

    func Close(_ id: int) {
        guard let i = ws.Index(of: id) else { return }
        let tab = ws.Tabs[i]
        tab.shell.Close()
        ws.Tabs.remove(at: i)
        if ws.Tabs.isEmpty {
            app.Quit()
            app.RequestFrame()
            return
        }
        if ws.Active == id {
            Select(ws.Tabs[min(i, ws.Tabs.count - 1)].ID)
        }
    }

    func Step(_ by: int) {
        guard let i = ws.Index(of: ws.Active), ws.Tabs.count > 1 else { return }
        let n = ws.Tabs.count
        Select(ws.Tabs[((i + by) % n + n) % n].ID)
    }

    // MARK: - Keys

    func KeyDown(_ e: dom.KeyboardEvent) {
        guard let shell = current else { return }
        let term = shell.term
        swallowText = false
        if e.Meta {
            if shortcut(e, shell) { e.PreventDefault() }
            return
        }
        if e.Control && e.Code == "Tab" {
            Step(e.Shift ? -1 : 1)
            e.PreventDefault()
            return
        }
        if e.Shift && !e.Control && !e.Alt && (e.Code == "PageUp" || e.Code == "PageDown") {
            term.ScrollView(by: e.Code == "PageUp" ? term.Rows - 1 : -(term.Rows - 1))
            redraw()
            e.PreventDefault()
            return
        }
        let mods = vt.Modifiers(shift: e.Shift, alt: e.Alt, control: e.Control, meta: e.Meta)
        if let bytes = term.EncodeKey(key: e.Key, code: e.Code, mods, altSendsEscape: optionAsMeta) {
            e.PreventDefault()
            if e.Alt && optionAsMeta { swallowText = true }
            typed(shell, bytes)
        }
    }

    /// The ⌘ shortcuts; true where the key was one.
    func shortcut(_ e: dom.KeyboardEvent, _ shell: Shell) -> bool {
        switch e.Code {
        case "KeyT": NewTab()
        case "KeyW": Close(ws.Active)
        case "KeyC": copySelection(shell)
        case "KeyV":
            let text = window.ClipboardText()
            if !text.isEmpty { typed(shell, shell.term.EncodePaste(text)) }
        case "KeyA":
            let t = shell.term
            shell.selection = view.Selection(startColumn: 0, startLine: 0, endColumn: t.Columns - 1,
                                             endLine: t.ScrollbackCount + t.Rows - 1)
            redraw()
        case "KeyK":
            shell.term.ClearScrollback()
            shell.selection = nil
            // ^L: the shell clears the screen and draws its prompt again.
            shell.Send([12])
            redraw()
        case "Equal": zoom(1)
        case "Minus": zoom(-1)
        case "Digit0": zoom(0)
        case "BracketLeft": if e.Shift { Step(-1) } else { return false }
        case "BracketRight": if e.Shift { Step(1) } else { return false }
        case "Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9":
            let b = [uint8](e.Code.utf8)
            let n = int(b[5] - 0x30)
            // ⌘9 is the last tab, as browsers have it.
            let i = n == 9 ? ws.Tabs.count - 1 : n - 1
            if i < ws.Tabs.count { Select(ws.Tabs[i].ID) }
        default:
            return false
        }
        return true
    }

    func zoom(_ step: int) {
        let size: float32 = step == 0 ? 13 : renderer.FontSize + float32(step)
        renderer.SetFont(size: size)
        redraw()
    }

    func BeforeInput(_ e: dom.InputEvent) {
        if swallowText {
            swallowText = false
            return
        }
        guard let shell = current else { return }
        typed(shell, shell.term.EncodeText(e.Data))
    }

    /// Sends what the user typed: the view goes back to the screen, the
    /// selection goes, and the cursor shows.
    func typed(_ shell: Shell, _ bytes: [uint8]) {
        shell.term.ScrollToBottom()
        shell.selection = nil
        blinkOn = true
        blinkEpoch += 1
        shell.Send(bytes)
        redraw()
    }

    func copySelection(_ shell: Shell) {
        guard let s = shell.selection?.Ordered, !s.IsEmpty else { return }
        let text = shell.term.Text(fromColumn: s.StartColumn, line: s.StartLine, toColumn: s.EndColumn, line: s.EndLine)
        if !text.isEmpty { window.SetClipboardText(text) }
    }

    func Focus(_ on: bool) {
        focused = on
        blinkOn = true
        if let shell = current, let report = shell.term.EncodeFocus(on) { shell.Send(report) }
        redraw()
    }

    // MARK: - The pointer

    /// The cell under a pointer event.
    func cellAt(_ x: float32, _ y: float32) -> (Column: int, Row: int, Right: bool) {
        let o = handle?.Origin ?? (X: 0, Y: 0)
        let t = current?.term
        return renderer.CellAt(x: x - o.X, y: y - o.Y, scale: scale, columns: t?.Columns ?? 80, rows: t?.Rows ?? 24)
    }

    func mods(_ e: dom.MouseEvent) -> vt.Modifiers {
        return vt.Modifiers(shift: e.Shift, alt: e.Alt, control: e.Control, meta: e.Meta)
    }

    func PointerDown(_ e: dom.PointerEvent) {
        e.PreventDefault()
        focusSurface()
        guard let shell = current else { return }
        let term = shell.term
        let cell = cellAt(e.X, e.Y)
        // Shift takes the mouse back from a program that asked for it, to
        // select, as xterm has it.
        mouseReported = term.Mouse != .off && !e.Shift
        if mouseReported {
            mouseButton = Int(e.Button)
            if let b = term.EncodeMouse(button: mouseButton, column: cell.Column, row: cell.Row, kind: "press", mods(e)) {
                shell.Send(b)
            }
            return
        }
        let line = term.ViewTop + cell.Row
        if e.Button != 0 { return }
        if e.Clicks >= 3 {
            shell.selection = view.Selection(startColumn: 0, startLine: line, endColumn: term.Columns - 1, endLine: line)
            selecting = false
        } else if e.Clicks == 2 {
            let w = wordAt(term, cell.Column, line)
            shell.selection = view.Selection(startColumn: w.0, startLine: line, endColumn: w.1, endLine: line)
            selecting = false
        } else {
            shell.selection = nil
            anchorColumn = cell.Column
            anchorLine = line
            selecting = true
        }
        redraw()
    }

    func PointerMove(_ e: dom.PointerEvent) {
        guard let shell = current else { return }
        let term = shell.term
        // Movement goes to the program during its own press, or with no
        // button held where it asked for all motion; a Shift press is a
        // selection.
        if term.Mouse != .off && (mouseReported || (!e.Pressed && !selecting)) {
            if term.Mouse == .motion || (e.Pressed && mouseButton >= 0) {
                let cell = cellAt(e.X, e.Y)
                if let b = term.EncodeMouse(button: e.Pressed ? mouseButton : -1, column: cell.Column, row: cell.Row, kind: "move", mods(e)) {
                    shell.Send(b)
                }
            }
            return
        }
        if !selecting || !e.Pressed { return }
        let cell = cellAt(e.X, e.Y)
        let line = term.ViewTop + cell.Row
        var endCol = cell.Column
        let forward = line > anchorLine || (line == anchorLine && cell.Column >= anchorColumn)
        // The edge rounds to the nearer side of the cell under the pointer.
        if forward && !cell.Right { endCol -= 1 }
        var startCol = anchorColumn
        if !forward && cell.Right { endCol += 1 }
        if !forward { startCol = max(0, anchorColumn - 1) }
        if forward && line == anchorLine && endCol < anchorColumn {
            shell.selection = nil
        } else {
            shell.selection = view.Selection(startColumn: startCol, startLine: anchorLine, endColumn: max(0, endCol), endLine: line)
        }
        redraw()
    }

    func PointerUp(_ e: dom.PointerEvent) {
        guard let shell = current else { return }
        let term = shell.term
        if mouseReported && mouseButton >= 0 {
            let cell = cellAt(e.X, e.Y)
            if let b = term.EncodeMouse(button: mouseButton, column: cell.Column, row: cell.Row, kind: "release", mods(e)) {
                shell.Send(b)
            }
            mouseButton = -1
            mouseReported = false
            return
        }
        mouseReported = false
        selecting = false
    }

    func Wheel(_ e: dom.WheelEvent) {
        e.PreventDefault()
        guard let shell = current else { return }
        let term = shell.term
        let lineH = renderer.CellSize(scale: scale).Height
        wheel += e.DeltaY
        let lines = int(wheel / lineH)
        if lines == 0 { return }
        wheel -= float32(lines) * lineH
        if term.Mouse != .off && !e.Shift {
            let cell = cellAt(e.X, e.Y)
            let m = vt.Modifiers(shift: e.Shift, alt: e.Alt, control: e.Control, meta: e.Meta)
            for _ in 0..<abs(lines) {
                if let b = term.EncodeMouse(button: lines < 0 ? 64 : 65, column: cell.Column, row: cell.Row, kind: "press", m) {
                    shell.Send(b)
                }
            }
        } else if term.AltScreen && term.AlternateScroll {
            let key = lines < 0 ? "ArrowUp" : "ArrowDown"
            for _ in 0..<abs(lines) {
                if let b = term.EncodeKey(key: key, code: key, vt.Modifiers()) { shell.Send(b) }
            }
        } else {
            term.ScrollView(by: -lines)
            redraw()
        }
    }

    // MARK: - Drawing

    /// The viewport's frame: the tab in front, sized to the box.
    func Draw(_ w: int, _ h: int, _ t: float64) -> [uint8] {
        if let css = handle?.Size, css.Width > 0 { scale = float32(w) / css.Width }
        let dark = app.IsDark()
        let theme = dark ? view.Theme.dark : view.Theme.light
        if theme.Name != shownTheme {
            renderer.SetTheme(theme)
            shownTheme = theme.Name
        }
        let grid = renderer.GridSize(width: w, height: h, scale: scale)
        gridColumns = grid.Columns
        gridRows = grid.Rows
        guard let shell = current else {
            return [uint8](repeating: 0, count: w * h * 4)
        }
        let term = shell.term
        term.ForegroundRGB = (R: theme.Foreground.R, G: theme.Foreground.G, B: theme.Foreground.B)
        term.BackgroundRGB = (R: theme.Background.R, G: theme.Background.G, B: theme.Background.B)
        shell.Resize(columns: grid.Columns, rows: grid.Rows, width: w, height: h)
        if let text = term.TakeClipboard() { window.SetClipboardText(text) }
        let visible = !term.CursorBlink || !focused || blinkOn
        return renderer.Draw(term, width: w, height: h, scale: scale,
                             cursor: view.CursorState(visible: visible, focused: focused), selection: shell.selection)
    }

    /// What the command line asks for after the first shell starts, for
    /// demonstrations and tests: `--tabs n` opens more tabs, `--type text`
    /// types into the one in front ("\n" as Enter).
    func scripted(_ args: [string]) async {
        var i = 1
        while i < args.count {
            if args[i] == "--tabs" && i + 1 < args.count {
                let n = int(args[i + 1]) ?? 1
                for _ in 1..<max(1, n) { NewTab(dir: nil) }
                i += 1
            } else if args[i] == "--type" && i + 1 < args.count {
                try? await Task.sleep(nanoseconds: 700_000_000)
                if let shell = current {
                    let text = unescapeNewlines(args[i + 1])
                    typed(shell, shell.term.EncodeText(text))
                }
                i += 1
            }
            i += 1
        }
    }

    /// Blinks the cursor while the terminal has focus.
    func blink() async {
        while true {
            try? await Task.sleep(nanoseconds: 530_000_000)
            if focused, let t = current?.term, t.CursorBlink, t.CursorVisible {
                blinkOn = !blinkOn
                redraw()
            }
        }
    }
}

/// Text with each "\\n" (backslash, n) as a newline.
func unescapeNewlines(_ s: string) -> string {
    let b = [uint8](s.utf8)
    var out: [uint8] = []
    var i = 0
    while i < b.count {
        if b[i] == 0x5C && i + 1 < b.count && b[i + 1] == 0x6E {
            out.append(10)
            i += 2
        } else {
            out.append(b[i])
            i += 1
        }
    }
    return string(decoding: out, as: UTF8.self)
}

/// The word around a cell: the run of characters that aren't spaces or
/// punctuation that ends words in a shell.
func wordAt(_ term: vt.Terminal, _ col: int, _ line: int) -> (int, int) {
    let cells = term.Absolute(line).Cells
    func isWord(_ i: int) -> bool {
        let r = cells[i].Rune
        if r == 0 || r == 32 { return false }
        // Quotes, brackets and separators end a word; paths and URLs stay
        // whole.
        let stops: [uint32] = [0x22, 0x27, 0x60, 0x28, 0x29, 0x5B, 0x5D, 0x7B, 0x7D, 0x3C, 0x3E, 0x7C, 0x3B, 0x2C]
        return !stops.contains(r)
    }
    if col >= cells.count || !isWord(col) { return (col, col) }
    var a = col
    var b = col
    while a > 0 && isWord(a - 1) { a -= 1 }
    while b + 1 < cells.count && isWord(b + 1) { b += 1 }
    return (a, b)
}

@MainActor
func TabBar(c: Controller) -> component.Node {
    let ws = c.ws
    return (
        <header class="tabbar">
            <div class="tabs">
                <component.For each={ws.Tabs} key={t in t.ID}>
                    {t in
                        <div class="tab" class:active={ws.Active == t.ID} class:bell={t.Bell} title={t.Title} onClick={c.Select(t.ID)}>
                            <span class="dot"></span>
                            <span class="label">{t.Title}</span>
                            <button class="close" title="Close tab (⌘W)" onClick={e in
                                e.StopPropagation()
                                c.Close(t.ID)
                            }>×</button>
                        </div>
                    }
                </component.For>
            </div>
            <button class="new" title="New tab (⌘T)" onClick={c.NewTab()}>+</button>
        </header>
    )
}

/// The window: the tab bar and the terminal surface. A controller can be
/// given, to drive and read it from outside (a test).
@MainActor
public func TerminalWindow(controller: Controller? = nil) -> component.Node {
    let c = controller ?? Controller()
    @state.State var surface: component.Ref = nil
    component.OnMount {
        c.surfaceNode = surface
        c.NewTab(dir: nil)
        c.focusSurface()
        Task { await c.blink() }
        Task { await c.scripted(CommandLine.arguments) }
    }
    return (
        <div class="window">
            <TabBar c={c} />
            <div class="surface" tabindex="0" ref={$surface}
                 onKeyDown={e in c.KeyDown(e)}
                 onBeforeInput={e in c.BeforeInput(e)}
                 onPointerDown={e in c.PointerDown(e)}
                 onPointerMove={e in c.PointerMove(e)}
                 onPointerUp={e in c.PointerUp(e)}
                 onWheel={e in c.Wheel(e)}
                 onFocus={c.Focus(true)}
                 onBlur={c.Focus(false)}>
                {viewport.Viewport(class: "screen", handle: { h in c.handle = h }) { w, h, t in c.Draw(w, h, t) }}
            </div>
        </div>
    )
}
