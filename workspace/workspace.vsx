// Package workspace is the terminal app's window, as Windows Terminal's:
// a tab bar over the terminal surface; each tab's panes, split side by
// side or one above another, each a shell under a pseudo-terminal
// (os/pty) whose screen vt keeps and view draws; a command palette,
// find, menus and dialogs over it; and Windows Terminal's settings.json,
// its profiles, color schemes, actions and keys. cmd/terminal runs it in
// a window; cmd/check-ui mounts it headless and types into it.
//
//     app.Run(title: "Terminal") { <workspace.TerminalWindow /> }
package workspace

import (
    "terminal/view"
    "terminal/vt"
    "ui/app"
    "ui/component"
    "ui/state"
    "ui/viewport"
    "web/dom"
    "web/html"
)

@MainActor
func TabItem(c: Controller, t: Tab) -> Element {
    let ui = c.ui
    @state.State var node: component.Ref = nil
    component.OnMount { c.tabNodes[t.ID] = node }
    return (
        <div ref={$node}
             className={"tab" + (c.IsFront(t.ID) ? " active" : "") + (t.Bell ? " bell" : "") + (!t.Color.isEmpty ? " colored" : "") + (ui.Dragging == t.ID ? " dragging" : "")}
             style={Style(
                 background: c.IsFront(t.ID) ? ui.SurfaceColor : "",
                 color: c.IsFront(t.ID) ? ui.SurfaceText : "",
                 left: ui.Dragging == t.ID ? "\(ui.DragShift)px" : ""
             )}
             title={t.Shown}
             onPointerDown={e in
                if e.Button == 1 {
                    c.Close(t.ID)
                } else if e.Button == 0 {
                    c.Select(t.ID)
                    c.tabPressed(t.ID, x: e.X)
                }
             }
             onClick={_ in c.Select(t.ID)}
             onDoubleClick={_ in c.startRename(t.ID)}
             onContextMenu={e in
                e.PreventDefault()
                c.openTabMenu(t.ID, x: e.X, y: e.Y)
             }>
            {if c.IsFront(t.ID) {
                <div className="foot left" style={Style(color: ui.SurfaceColor)}>
                    <svg width="10" height="10" viewBox="0 0 10 10"><path d="M10 0 L10 10 L0 10 C5.5 10 10 5.5 10 0 Z" fill="currentColor" /></svg>
                </div>
            }}
            {if c.IsFront(t.ID) {
                <div className="foot right" style={Style(color: ui.SurfaceColor)}>
                    <svg width="10" height="10" viewBox="0 0 10 10"><path d="M0 0 L0 10 L10 10 C4.5 10 0 5.5 0 0 Z" fill="currentColor" /></svg>
                </div>
            }}
            {if !t.Color.isEmpty { <span className="stripe" style={Style(background: t.Color)}></span> }}
            {if !t.Icon.isEmpty {
                <span className="icon">{t.Icon}</span>
            } else {
                <span className={t.Bell ? "favicon bell" : "favicon"}>
                    <svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 2.5 C2 2.2 2.2 2 2.5 2 L13.5 2 C13.8 2 14 2.2 14 2.5 L14 13.5 C14 13.8 13.8 14 13.5 14 L2.5 14 C2.2 14 2 13.8 2 13.5 Z M3.2 3.2 L3.2 12.8 L12.8 12.8 L12.8 3.2 Z M4.6 5.4 L5.4 4.6 L8.2 7.4 L5.4 10.2 L4.6 9.4 L6.6 7.4 Z M8.4 9.6 L11.4 9.6 L11.4 10.6 L8.4 10.6 Z" fill="currentColor" /></svg>
                </span>
            }}
            <span className="dot"></span>
            {if ui.Renaming == t.ID {
                <input className="rename" value={ui.RenameText} autofocus
                       onInput={e in ui.RenameText = e.Value}
                       onKeyDown={e in
                           e.StopPropagation()
                           if e.Key == "Enter" { c.commitRename() }
                           if e.Key == "Escape" { c.cancelRename() }
                       }
                       onBlur={_ in if ui.Renaming == t.ID { c.commitRename() }} />
            } else {
                <span className="label">{t.Shown}</span>
            }}
            {if t.IsZoomed { <span className="badge" title="A pane is zoomed">⤢</span> }}
            {if t.Broadcast { <span className="badge" title="Broadcasting input to every pane">📡</span> }}
            {if t.ReadOnly { <span className="badge" title="The pane is read-only">🔒</span> }}
            {if t.PaneCount > 1 { <span className="badge panes" title="Panes">{t.PaneCount}</span> }}
            <div className="close" role="button" title="Close tab" onPointerDown={e in e.StopPropagation()} onClick={e in
                e.StopPropagation()
                c.Close(t.ID)
            }>
                <svg width="10" height="10" viewBox="0 0 10 10"><path d="M1.3 0.5 L9.5 8.7 L8.7 9.5 L0.5 1.3 Z M8.7 0.5 L9.5 1.3 L1.3 9.5 L0.5 8.7 Z" fill="currentColor" /></svg>
            </div>
            {if !t.Progress.isEmpty {
                <div className={"progress" + (t.Progress == "error" ? " error" : "") + (t.Progress == "paused" ? " paused" : "") + (t.Progress == "indeterminate" ? " indeterminate" : "")}
                     style={Style(width: t.Progress == "indeterminate" ? "100%" : "\(max(3, t.ProgressValue))%")}></div>
            }}
        </div>
    )
}

@MainActor
func TabBar(c: Controller) -> Element {
    let ws = c.ws
    let ui = c.ui
    return (
        <header className={"tabbar" + (c.liveSettings.TabWidthMode == "compact" ? " compact" : "") + (c.liveSettings.TabWidthMode == "titleLength" ? " fit" : "") + (ui.InTitlebar && !ui.Fullscreen ? " titlebar" : "") + (ui.Dragging != 0 ? " dragging" : "")}
                onPointerDown={e in
                    // An empty part of the bar is the title bar: it moves
                    // the window, and a double-click zooms it.
                    guard let n = e.Target, n.HasClass("tabbar") || n.HasClass("spacer") || n.HasClass("tabs") else { return }
                    if e.Clicks == 2 { app.TitlebarDoubleClick() } else { app.StartWindowDrag() }
                }>
            <div className="more" role="button" title={"Profiles and settings (" + c.liveSettings.KeysFor("Terminal.OpenNewTabDropdown") + ")"} onClick={e in
                c.openNewTabMenu(x: e.X - 14, y: 42)
            }>
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="M1.6 3.6 L6 8 L10.4 3.6 L11.2 4.4 L6 9.6 L0.8 4.4 Z" fill="currentColor" /></svg>
            </div>
            <div className="tabs">
                {ws.Tabs.map { t in <TabItem key={t.ID} c={c} t={t} /> }}
                {if ui.SettingsOpen { <SettingsTabItem c={c} /> }}
            </div>
            <div className="new" role="button" title={"New tab (" + c.liveSettings.KeysFor("Terminal.OpenNewTab") + ")"} onClick={c.NewTab()}>
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="M5.4 0.5 L6.6 0.5 L6.6 11.5 L5.4 11.5 Z M0.5 5.4 L11.5 5.4 L11.5 6.6 L0.5 6.6 Z" fill="currentColor" /></svg>
            </div>
            <div className="spacer"></div>
        </header>
    )
}

@MainActor
func SearchBox(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="search" onPointerDown={e in e.StopPropagation()}>
            <input className="query" placeholder="Find" value={ui.SearchText} autofocus
                   onInput={e in
                       ui.SearchText = e.Value
                       c.searchChanged()
                   }
                   onKeyDown={e in
                       e.StopPropagation()
                       if e.Key == "Enter" {
                           e.PreventDefault()
                           c.stepMatch(e.Shift ? -1 : 1)
                       } else if e.Key == "Escape" {
                           c.closeSearch()
                       } else if e.Meta && e.Code == "KeyG" {
                           e.PreventDefault()
                           c.stepMatch(e.Shift ? -1 : 1)
                       }
                   } />
            <span className="status">{ui.SearchStatus}</span>
            <button className={ui.SearchCase ? "toggle on" : "toggle"} title="Match case" onClick={_ in
                ui.SearchCase = !ui.SearchCase
                c.searchChanged()
            }>Aa</button>
            <button title="Previous match (⇧↩)" onClick={_ in c.stepMatch(-1)}>↓</button>
            <button title="Next match (↩)" onClick={_ in c.stepMatch(1)}>↑</button>
            <button title="Close (⎋)" onClick={_ in c.closeSearch()}>×</button>
        </div>
    )
}

@MainActor
func Palette(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="scrim" onPointerDown={e in
            e.StopPropagation()
            c.closePalette()
        }>
            <div className="palette" onPointerDown={e in e.StopPropagation()}>
                <input className="query" placeholder={ui.PaletteTitle} value={ui.PaletteText} autofocus
                       onInput={e in
                           ui.PaletteText = e.Value
                           ui.PaletteIndex = 0
                           c.filterPalette()
                       }
                       onKeyDown={e in
                           e.StopPropagation()
                           if c.PaletteKey(e.Key, control: e.Control, shift: e.Shift) { e.PreventDefault() }
                       }
                       onKeyUp={e in
                           if e.Key == "Control" { c.SwitcherRelease() }
                       } />
                <div className="items">
                    {ui.PaletteShown.map { it in
                        <div key={it.ID}
                             className={ui.PaletteItems.count > ui.PaletteIndex && ui.PaletteItems[ui.PaletteIndex].ID == it.ID ? "item selected" : "item"}
                             onClick={_ in
                                 if let i = ui.PaletteItems.firstIndex(where: { $0.ID == it.ID }) { c.runPalette(i) }
                             }>
                            {if !it.Swatch.isEmpty { <span className="swatch" style={Style(background: it.Swatch)}></span> }}
                            <span className="label">{it.Label}</span>
                            {if it.Nested { <span className="detail">›</span> } else { <span className="detail">{it.Detail}</span> }}
                        </div>
                    }}
                    {if ui.PaletteItems.isEmpty { <div className="empty">No matching commands</div> }}
                </div>
            </div>
        </div>
    )
}

@MainActor
func Menu(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="scrim clear" onPointerDown={e in
            e.StopPropagation()
            c.closeMenu()
        } onContextMenu={e in e.PreventDefault()}>
            <div className="menu" style={Style(left: "\(ui.MenuX)px", top: "\(ui.MenuY)px")} onPointerDown={e in e.StopPropagation()}>
                {ui.MenuItems.map { it in
                    <div key={it.ID} className={it.Separator ? "sep" : "mitem"} onClick={_ in if !it.Separator { c.runMenu(it.ID) }}>
                        {if !it.Separator {
                            <span className="label">{it.Label}</span>
                        }}
                        {if !it.Separator {
                            <span className="detail">{it.Detail.hasPrefix("#") ? "" : it.Detail}</span>
                        }}
                    </div>
                }}
            </div>
        </div>
    )
}

@MainActor
func Dialog(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="scrim dim" onPointerDown={e in e.StopPropagation()}>
            <div className="dialog" tabindex="0" autofocus onKeyDown={e in
                e.StopPropagation()
                if e.Key == "Enter" { c.runDialog(0) }
                if e.Key == "Escape" { c.runDialog(ui.DialogButtons.count - 1) }
            }>
                <h3>{ui.DialogTitle}</h3>
                <p>{ui.DialogBody}</p>
                <div className="buttons">
                    {ui.DialogButtons.map { b in
                        <button key={b.ID} className={b.ID == 0 ? "primary" : ""} onClick={_ in c.runDialog(b.ID)}>{b.Label}</button>
                    }}
                </div>
            </div>
        </div>
    )
}

@MainActor
func WindowRenamer(c: Controller) -> Element {
    let ui = c.ui
    return (
        <div className="scrim dim" onPointerDown={e in e.StopPropagation()}>
            <div className="dialog">
                <h3>Rename window</h3>
                <input className="query" value={ui.RenameText} autofocus
                       onInput={e in ui.RenameText = e.Value}
                       onKeyDown={e in
                           e.StopPropagation()
                           if e.Key == "Enter" { c.commitRename() }
                           if e.Key == "Escape" { c.cancelRename() }
                       } />
            </div>
        </div>
    )
}

/// The window: the tab bar, the terminal surface, and what goes over it.
/// A controller can be given, to drive and read it from outside (a test).
@MainActor
public func TerminalWindow(controller: Controller? = nil) -> Element {
    let c = controller ?? Controller()
    let ui = c.ui
    @state.State var surface: component.Ref = nil
    component.OnMount {
        c.surfaceNode = surface
        app.OnCloseRequest { c.tryQuit() }
        c.Launch(CommandLine.arguments)
        c.focusSurface()
        Task { await c.tick() }
        Task { await c.scripted(CommandLine.arguments) }
    }
    return (
        <div className="window" onPointerMove={e in c.tabDragMove(x: e.X)} onPointerUp={_ in c.tabDragEnd()}>
            {if !ui.FocusMode && (c.liveSettings.AlwaysShowTabs || c.ws.Tabs.count > 1) { <TabBar c={c} /> }}
            {if (ui.FocusMode || (!c.liveSettings.AlwaysShowTabs && c.ws.Tabs.count <= 1)) && ui.InTitlebar && !ui.Fullscreen {
                <div className="dragstrip" onPointerDown={e in if e.Clicks == 2 { app.TitlebarDoubleClick() } else { app.StartWindowDrag() }}></div>
            }}
            <div className="stage">
                <div className="surface" tabindex="0" ref={$surface}
                     onKeyDown={e in c.KeyDown(e)}
                     onKeyUp={e in c.KeyUp(e)}
                     onBeforeInput={e in c.BeforeInput(e)}
                     onPointerDown={e in c.PointerDown(e)}
                     onPointerMove={e in c.PointerMove(e)}
                     onPointerUp={e in c.PointerUp(e)}
                     onWheel={e in c.Wheel(e)}
                     onContextMenu={e in e.PreventDefault()}
                     onFocus={c.Focus(true)}
                     onBlur={c.Focus(false)}>
                    {viewport.Viewport(class: "screen", handle: { h in c.handle = h }) { w, h, t in c.Draw(w, h, t) }}
                </div>
                {if ui.SettingsShown { <SettingsPage c={c} /> }}
                {if ui.Search { <SearchBox c={c} /> }}
                {if !ui.Hover.isEmpty { <div className="hover">{ui.Hover}</div> }}
                {if !ui.Toast.isEmpty { <div className="toast">{ui.Toast}</div> }}
                {if ui.Palette { <Palette c={c} /> }}
                {if ui.Menu { <Menu c={c} /> }}
                {if ui.Dialog { <Dialog c={c} /> }}
                {if ui.RenamingWindow { <WindowRenamer c={c} /> }}
            </div>
        </div>
    )
}

extension Controller {
    /// The first tabs: what the command line asks (wt's subcommands, or
    /// --profile), else the settings' startupActions, else one tab of the
    /// default profile; and the window as launchMode says.
    func Launch(_ args: [string]) {
        if !settings.Warnings.isEmpty { toast(settings.Warnings[0]) }
        var words: [string] = []
        var i = 1
        while i < args.count {
            let a = args[i]
            // The test and demo flags, and ui/app's.
            if a == "--tabs" || a == "--type" || a == "--snapshot" || a == "--snapshot-after" || a == "--quit-after" || a == "--action" {
                i += 2
                continue
            }
            if a == "--dark" || a == "--light" || a == "--" {
                i += 1
                continue
            }
            words.append(a.contains(" ") ? "\"\(a)\"" : a)
            i += 1
        }
        if !words.isEmpty {
            runCommandline(words.joined(separator: " "))
        } else if restoreSession() {
            // The last session's tabs.
        } else if !settings.StartupActions.isEmpty {
            runCommandline(settings.StartupActions)
        }
        if ws.Tabs.isEmpty { NewTab(profile: nil, dir: nil) }
        switch settings.LaunchMode {
        case "fullscreen": app.SetFullscreen(true)
        case "focus", "maximizedFocus": ui.FocusMode = true
        default: break
        }
        if settings.AlwaysOnTop {
            alwaysOnTop = true
            app.SetAlwaysOnTop(true)
        }
        applyOpacity()
    }

    /// What the command line asks for after the first shell starts, for
    /// demonstrations and tests: `--tabs n` opens more tabs, `--type text`
    /// types into the one in front ("\n" as Enter).
    func scripted(_ args: [string]) async {
        var i = 1
        while i < args.count {
            if args[i] == "--tabs" && i + 1 < args.count {
                let n = int(args[i + 1]) ?? 1
                for _ in 1..<max(1, n) { NewTab(dir: nil) }
                i += 1
            } else if args[i] == "--action" && i + 1 < args.count {
                // Runs an action by id, as its key would.
                try? await Task.sleep(nanoseconds: 900_000_000)
                RunAction(args[i + 1])
                app.RequestFrame()
                i += 1
            } else if args[i] == "--quit-after" && i + 1 < args.count {
                // Quits as ⌘Q does (the session saved), for tests.
                let secs = float64(args[i + 1]) ?? 1
                try? await Task.sleep(nanoseconds: uint64(secs * 1_000_000_000))
                quitConfirmed = false
                if tryQuit() {
                    app.Quit()
                    app.RequestFrame()
                } else if ui.Dialog {
                    runDialog(0)
                }
                i += 1
            } else if args[i] == "--type" && i + 1 < args.count {
                try? await Task.sleep(nanoseconds: 700_000_000)
                if let pane = currentPane {
                    let text = unescapeNewlines(args[i + 1])
                    typed(pane, pane.shell.term.EncodeText(text))
                }
                i += 1
            }
            i += 1
        }
    }
}

/// Text with each "\\n" (backslash, n) as a newline.
func unescapeNewlines(_ s: string) -> string {
    let b = [uint8](s.utf8)
    var out: [uint8] = []
    var i = 0
    while i < b.count {
        if b[i] == 0x5C && i + 1 < b.count && b[i + 1] == 0x6E {
            out.append(10)
            i += 2
        } else {
            out.append(b[i])
            i += 1
        }
    }
    return string(decoding: out, as: UTF8.self)
}
