/* The terminal's window: a tab bar over the terminal surface, and what
   goes over it (find, the command palette, menus, dialogs), in the
   system's appearance. The surface's own colors are view's theme. The
   variables are on .window: a package's sheet applies to its own
   elements. */
package workspace

.window {
    --bar: #dee1e6;
    --bar-border: #d4d4d4;
    --tab: transparent;
    --tab-hover: rgba(255, 255, 255, 0.45);
    --sep: #a8acb3;
    --button: rgba(0, 0, 0, 0.06);
    --button-hover: rgba(0, 0, 0, 0.1);
    --tab-active: #ffffff;
    --text: #45474a;
    --text-active: #1e1e1e;
    --accent: #2f6fec;
    --surface: #ffffff;
    --panel: #f7f7f7;
    --panel-border: #cfcfcf;
    --panel-hover: #e6eefc;
    --shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
    --muted: #888888;
}

.window {
    display: flex;
    flex-direction: column;
    height: 100%;
}

/* The tab bar, as Chrome's: the ⌄ menu as a rounded button on the left,
   rounded tabs on the bar's bottom edge (the one in front in the
   terminal's own colors, flaring into it at its feet), thin lines between
   the others, and + right after the last tab. With the tabs in the title
   bar, room is left for the window's buttons, and the bar's empty parts
   move the window. */
.tabbar {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 40px;
    flex: none;
    padding: 0 8px;
    background: var(--bar);
    font: 12px system-ui;
    color: var(--text);
    &.titlebar { padding-left: 78px; }
}

.dragstrip {
    height: 28px;
    flex: none;
    background: var(--bar);
}

.tabs {
    display: flex;
    align-items: flex-end;
    flex: 0 1 auto;
    min-width: 0;
    height: 100%;
    padding: 0 10px;
    overflow: hidden;
}

.spacer {
    flex: 1;
    min-width: 0;
    height: 100%;
}

.tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 0 1 240px;
    width: 240px;
    min-width: 56px;
    height: 34px;
    padding: 0 7px 0 12px;
    border-radius: 10px 10px 0 0;
    background: transparent;
    color: var(--text);
    cursor: default;
    &:hover { background: var(--tab-hover); }
    &.active {
        background: var(--tab-active);
        color: var(--text-active);
    }
    &.dragging { opacity: 0.75; }
}

/* The lines between tabs: none beside the one in front or hovered. */
.tab + .tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 1px;
    background: var(--sep);
}
.tab.active::before, .tab.active + .tab::before, .tab:hover::before, .tab:hover + .tab::before {
    background: transparent;
}

/* The active tab's feet: the terminal's color curving out at its bottom
   corners. */
.foot {
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
    &.left { left: -10px; }
    &.right { right: -10px; }
}

/* A tab's color: a band along its top, inside its rounded corners. */
.stripe {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 0;
    height: 3px;
    border-radius: 0 0 3px 3px;
}

/* Tab widths: equal (the default), as long as the title, or compact. */
.tabbar.fit .tab { flex: 0 1 auto; width: auto; max-width: 320px; }
.tabbar.compact .tab { flex: 0 0 auto; width: auto; min-width: 40px; max-width: 120px; }
.tabbar.compact .tab:not(.active) .label { display: none; }

.favicon {
    display: flex;
    flex: none;
    opacity: 0.8;
}

/* A bell rang in a tab behind: a dot until it is shown. */
.dot {
    display: none;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--accent);
}
.tab.bell .dot { display: block; }

.icon {
    flex: none;
    font-size: 13px;
}

.label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.badge {
    flex: none;
    font-size: 10px;
    opacity: 0.75;
}
.badge.panes {
    min-width: 14px;
    height: 14px;
    line-height: 14px;
    border-radius: 7px;
    text-align: center;
    background: rgba(127, 127, 127, 0.25);
}

.rename {
    flex: 1;
    min-width: 0;
    height: 20px;
    padding: 0 4px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-active);
    font: 12px system-ui;
    outline: none;
}

/* A program's progress (OSC 9;4): a bar along the tab's bottom. */
.progress {
    position: absolute;
    left: 10px;
    bottom: 0;
    height: 2px;
    max-width: calc(100% - 20px);
    background: #2ea043;
    &.error { background: #e5484d; }
    &.paused { background: #d4a72c; }
    &.indeterminate { background: repeating-linear-gradient(90deg, #2ea043 0 12px, transparent 12px 24px); }
}

.close {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    color: inherit;
    opacity: 0.7;
    &:hover { opacity: 1; background: var(--button-hover); }
}

/* + after the tabs, and ⌄ before them: round and rounded-square buttons. */
.new {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 28px;
    height: 28px;
    margin-bottom: 3px;
    border-radius: 14px;
    color: inherit;
    &:hover { background: var(--button-hover); }
}
.more {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 28px;
    margin-bottom: 3px;
    border-radius: 9px;
    background: var(--button);
    color: inherit;
    &:hover { background: var(--button-hover); }
}

.stage {
    flex: 1;
    min-height: 0;
    position: relative;
}

.surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: var(--surface);
    outline: none;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Find: a box at the top right. */
.search {
    position: absolute;
    top: 8px;
    right: 22px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 6px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    box-shadow: var(--shadow);
    font: 12px system-ui;
    color: var(--text-active);
    & button {
        min-width: 24px;
        height: 22px;
        border: none;
        border-radius: 4px;
        background: transparent;
        color: inherit;
        font: 12px system-ui;
        &:hover { background: var(--panel-hover); }
        &.on { background: var(--accent); color: #ffffff; }
    }
}
.status {
    min-width: 56px;
    color: var(--muted);
    text-align: center;
}

.query {
    width: 220px;
    height: 24px;
    padding: 0 8px;
    border: 1px solid var(--panel-border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-active);
    font: 13px system-ui;
    outline: none;
    &:focus { border-color: var(--accent); }
}

/* What goes over everything: the palette, menus, dialogs. A scrim takes
   the clicks around them. */
.scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    &.dim { background: rgba(0, 0, 0, 0.3); display: flex; align-items: center; justify-content: center; }
}

.palette {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 560px;
    max-width: 90%;
    margin-left: -280px;
    padding: 8px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    box-shadow: var(--shadow);
    font: 13px system-ui;
    color: var(--text-active);
    & .query { width: 100%; box-sizing: border-box; height: 30px; }
}
.items {
    max-height: 360px;
    overflow: hidden;
    margin-top: 6px;
}
.item {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 8px;
    border-radius: 4px;
    &:hover { background: var(--panel-hover); }
    &.selected { background: var(--accent); color: #ffffff; }
    &.selected .detail { color: rgba(255, 255, 255, 0.8); }
}
.detail {
    flex: none;
    color: var(--muted);
    font-size: 12px;
}
.swatch {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid rgba(127, 127, 127, 0.5);
}
.empty {
    padding: 8px;
    color: var(--muted);
}

.menu {
    position: absolute;
    min-width: 220px;
    padding: 4px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    box-shadow: var(--shadow);
    font: 13px system-ui;
    color: var(--text-active);
}
.mitem {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 24px;
    padding: 0 10px;
    border-radius: 4px;
    &:hover { background: var(--accent); color: #ffffff; }
    &:hover .detail { color: rgba(255, 255, 255, 0.8); }
}
.sep {
    height: 1px;
    margin: 4px 6px;
    background: var(--panel-border);
}

.dialog {
    width: 380px;
    padding: 18px 20px 14px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    font: 13px system-ui;
    color: var(--text-active);
    outline: none;
    & h3 { margin: 0 0 8px; font-size: 14px; }
    & p { margin: 0 0 14px; color: var(--text); white-space: pre-wrap; }
    & .query { width: 100%; box-sizing: border-box; }
}
.buttons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    & button {
        min-width: 80px;
        height: 26px;
        border: 1px solid var(--panel-border);
        border-radius: 5px;
        background: var(--surface);
        color: var(--text-active);
        font: 13px system-ui;
        &.primary { background: var(--accent); border-color: var(--accent); color: #ffffff; }
    }
}

.toast {
    position: absolute;
    left: 50%;
    bottom: 16px;
    width: 440px;
    margin-left: -220px;
    padding: 8px 12px;
    background: rgba(32, 32, 32, 0.92);
    border-radius: 6px;
    color: #ffffff;
    font: 12px system-ui;
    text-align: center;
}

/* The link under the pointer, at the bottom left. */
.hover {
    position: absolute;
    left: 6px;
    bottom: 6px;
    max-width: 70%;
    padding: 3px 8px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 4px;
    color: var(--text);
    font: 11px system-ui;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* The settings tab's page, over the terminal: a sidebar of pages beside
   cards of settings, light and quiet. */
.window {
    --sbg: #ffffff;
    --snav: #f9f9f9;
    --snav-border: #ececec;
    --snav-active: #ececec;
    --snav-hover: #f0f0f0;
    --ssearch: #efefef;
    --scard-border: #e3e3e3;
    --srow-sep: #ececec;
    --stitle: #0d0d0d;
    --sdetail: #5d5d5d;
    --sfaint: #8f8f8f;
    --switch-off: #dcdcdc;
    --switch-on: #0d0d0d;
    --knob: #ffffff;
    --knob-on: #ffffff;
    --sfield: #f4f4f4;
}

.tab.settings-tab.active {
    background: var(--sbg);
    color: var(--stitle);
}
.sfoot { color: var(--sbg); }

.settings {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    background: var(--sbg);
    color: var(--stitle);
    font: 14px system-ui;
    outline: none;
}

.snav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: none;
    width: 236px;
    padding: 14px 8px;
    box-sizing: border-box;
    overflow-y: auto;
    scrollbar-width: none;
    background: var(--snav);
    border-right: 1px solid var(--snav-border);
}

.sback, .snavitem {
    display: flex;
    align-items: center;
    gap: 11px;
    height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    color: var(--stitle);
    font-size: 14.5px;
    cursor: default;
    &:hover { background: var(--snav-hover); }
}
.snavitem.active, .snavitem.active:hover { background: var(--snav-active); }
.sback { margin-bottom: 10px; }
.snavlabel {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.sout { display: flex; color: var(--sfaint); }

.ssearch {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 36px;
    margin-bottom: 12px;
    padding: 0 12px;
    border-radius: 18px;
    background: var(--ssearch);
    color: var(--sfaint);
}
.squery {
    flex: 1;
    min-width: 0;
    height: 30px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--stitle);
    font: 14.5px system-ui;
    outline: none;
}

.sheading {
    margin: 8px 10px 6px;
    color: var(--sfaint);
    font-size: 13.5px;
}

.smain {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    scrollbar-width: none;
}

.scontent {
    max-width: 560px;
    margin: 0 auto;
    padding: 22px 28px 48px;
    & h1 {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 400;
        letter-spacing: -0.2px;
    }
}
.ssub {
    color: var(--sdetail);
    font-size: 13px;
}
.sempty {
    margin-top: 28px;
    color: var(--sdetail);
}

.sgroup {
    margin-top: 30px;
    & h2 {
        margin: 0 0 12px;
        font-size: 17px;
        font-weight: 500;
    }
}

.scard {
    padding: 0 16px;
    border: 1px solid var(--scard-border);
    border-radius: 16px;
}

.srow {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 62px;
    padding: 11px 0;
    box-sizing: border-box;
}
.srow {
    border-top: 1px solid var(--srow-sep);
    &.first { border-top: none; }
}

.stext {
    flex: 1;
    min-width: 0;
}
.stitle {
    font-size: 14.5px;
    font-weight: 500;
}
.sdetail {
    margin-top: 3px;
    color: var(--sdetail);
    font-size: 13px;
    line-height: 1.35;
}

/* A switch: a rounded track, its knob at the right when on. */
.switch {
    position: relative;
    flex: none;
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: var(--switch-off);
    & .knob {
        position: absolute;
        left: 2px;
        top: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: var(--knob);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    &.on { background: var(--switch-on); }
    &.on .knob { left: 18px; background: var(--knob-on); }
}

.schoice {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: none;
    max-width: 240px;
    color: var(--stitle);
    font-size: 14px;
    & .icon { color: var(--sfaint); }
}
.svalue {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.sfield {
    flex: none;
    width: 220px;
    height: 32px;
    padding: 0 10px;
    box-sizing: border-box;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--sfield);
    color: var(--stitle);
    font: 13.5px system-ui;
    outline: none;
    &:focus { border-color: var(--scard-border); background: var(--sbg); }
}

.stepper {
    display: flex;
    align-items: center;
    flex: none;
    height: 32px;
    border-radius: 8px;
    background: var(--sfield);
}
.sstep {
    width: 30px;
    height: 32px;
    line-height: 32px;
    text-align: center;
    color: var(--sdetail);
    font-size: 16px;
    border-radius: 8px;
    &:hover { background: var(--snav-active); color: var(--stitle); }
}
.snum {
    width: 52px;
    height: 30px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--stitle);
    font: 13.5px system-ui;
    text-align: center;
    outline: none;
}

.skeys {
    flex: none;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--sfield);
    color: var(--sdetail);
    font-size: 12.5px;
}

.swatches {
    display: flex;
    gap: 3px;
    margin-top: 8px;
}
.sw {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px rgba(127, 127, 127, 0.25);
}
.scheck { display: flex; color: var(--stitle); }
.schev { display: flex; color: var(--sfaint); }

@media (prefers-color-scheme: dark) {
    .window {
        --bar: #202124;
        --bar-border: #191919;
        --tab-hover: rgba(255, 255, 255, 0.07);
        --sep: #5f6368;
        --button: rgba(255, 255, 255, 0.08);
        --button-hover: rgba(255, 255, 255, 0.14);
        --tab-active: #1e1e1e;
        --text: #bdc1c6;
        --text-active: #ffffff;
        --accent: #3b8eea;
        --surface: #1e1e1e;
        --panel: #2b2b2c;
        --panel-border: #3c3c3c;
        --panel-hover: #37373d;
        --muted: #8a8a8a;
        --sbg: #212121;
        --snav: #181818;
        --snav-border: #2a2a2a;
        --snav-active: #2f2f2f;
        --snav-hover: #262626;
        --ssearch: #2a2a2a;
        --scard-border: #353535;
        --srow-sep: #2f2f2f;
        --stitle: #ececec;
        --sdetail: #a3a3a3;
        --sfaint: #8a8a8a;
        --switch-off: #4a4a4a;
        --switch-on: #ececec;
        --knob: #ffffff;
        --knob-on: #212121;
        --sfield: #2c2c2c;
    }
}
