/* The terminal's window: a tab bar over the terminal surface, in the
   system's appearance. The surface's own colors are view's theme. The
   variables are on .window: a package's sheet applies to its own
   elements. */
package workspace

.window {
    --bar: #ececec;
    --bar-border: #d4d4d4;
    --tab: transparent;
    --tab-hover: #e0e0e0;
    --tab-active: #ffffff;
    --text: #555555;
    --text-active: #1e1e1e;
    --accent: #2f6fec;
    --surface: #ffffff;
}

.window {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.tabbar {
    display: flex;
    align-items: stretch;
    height: 34px;
    flex: none;
    background: var(--bar);
    border-bottom: 1px solid var(--bar-border);
    font: 12px system-ui;
    color: var(--text);
}

.tabs {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow: hidden;
}

.tab {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1 1 0;
    min-width: 60px;
    max-width: 220px;
    padding: 0 6px 0 12px;
    background: var(--tab);
    border-right: 1px solid var(--bar-border);
    cursor: default;
    &:hover { background: var(--tab-hover); }
    &.active {
        background: var(--tab-active);
        color: var(--text-active);
        box-shadow: inset 0 2px 0 var(--accent);
    }
}

/* A bell rang in a tab behind: a dot until it is shown. */
.dot {
    display: none;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--accent);
}
.tab.bell .dot { display: block; }

.label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.close {
    flex: none;
    width: 18px;
    height: 18px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: 14px system-ui;
    line-height: 18px;
    opacity: 0.55;
    &:hover { opacity: 1; background: rgba(0, 0, 0, 0.1); }
}

.new {
    flex: none;
    width: 34px;
    border: none;
    background: transparent;
    color: inherit;
    font: 18px system-ui;
    &:hover { background: var(--tab-hover); }
}

.surface {
    flex: 1;
    min-height: 0;
    position: relative;
    background: var(--surface);
    outline: none;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

@media (prefers-color-scheme: dark) {
    .window {
        --bar: #252526;
        --bar-border: #191919;
        --tab-hover: #2d2d2e;
        --tab-active: #1e1e1e;
        --text: #9d9d9d;
        --text-active: #ffffff;
        --accent: #3b8eea;
        --surface: #1e1e1e;
    }
    .close:hover { background: rgba(255, 255, 255, 0.12); }
}
