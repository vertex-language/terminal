// check-ui: the terminal window mounted headless, with real shells: what
// is typed into it reaches the shell, the shell's output reaches the
// screen and the pixels, and tabs open, switch and close.
//
//     vsc run check-ui
package main

import (
    "image/draw"
    "terminal/workspace"
    "time"
    "ui/componenttest"
    "web"
)

var failures = 0

func check(_ ok: bool, _ what: string) {
    if ok {
        print("ok   \(what)")
    } else {
        print("FAIL \(what)")
        failures += 1
    }
}

/// Waits up to seconds for cond, looking every 20 ms while the shells run.
func until(_ seconds: float64, _ cond: () -> bool) async -> bool {
    var waited: float64 = 0
    while waited < seconds {
        if cond() { return true }
        try? await Task.sleep(nanoseconds: 20_000_000)
        waited += 0.02
    }
    return cond()
}

/// How many times needle appears in text.
func count(_ text: string, _ needle: string) -> int {
    let t = [uint8](text.utf8)
    let n = [uint8](needle.utf8)
    var found = 0
    var i = 0
    while i + n.count <= t.count {
        var j = 0
        while j < n.count && t[i + j] == n[j] { j += 1 }
        if j == n.count {
            found += 1
            i += n.count
        } else {
            i += 1
        }
    }
    return found
}

@MainActor
func key(_ s: componenttest.Screen, _ key: string, _ code: string, control: bool = false, meta: bool = false, shift: bool = false, alt: bool = false) {
    _ = s.Page.Handle(.keyDown(web.Key(Key: key, Code: code, Shift: shift, Control: control, Alt: alt, Meta: meta)))
}

/// Whether every pane's screen shows something.
@MainActor
func prompted(_ c: workspace.Controller) -> bool {
    return c.PaneTexts().allSatisfy { !$0.allSatisfy { $0 == "\n" || $0 == " " } }
}

@MainActor
func type(_ s: componenttest.Screen, _ text: string) {
    _ = s.Page.Handle(.text(text))
}

@MainActor
func main() async -> int32 {
    let settings = """
    {
        // Comments and trailing commas, as Windows Terminal allows.
        "profiles": { "defaults": { "closeOnExit": "graceful", }, },
        "schemes": [ { "name": "Test Scheme", "background": "#102030", "foreground": "#FFFFFF" } ],
        "actions": [
            { "command": { "action": "sendInput", "input": "echo sent-$((5*5))\\r" }, "keys": "cmd+shift+u" },
            { "command": { "action": "setColorScheme", "colorScheme": "Test Scheme" }, "id": "User.Scheme" },
            { "command": { "action": "renameTab", "title": "My Tab" }, "id": "User.Rename" },
            { "command": { "action": "setTabColor", "color": "#C50E1F" }, "id": "User.Color" },
        ],
        "keybindings": [ { "keys": "cmd+shift+y", "id": "Terminal.TogglePaneZoom" } ]
    }
    """
    let c = workspace.Controller(settingsJSON: settings)
    let s = componenttest.Mount(width: 800, height: 500, css: "html, body { height: 100%; }") {
        <workspace.TerminalWindow controller={c} />
    }

    check(c.TabCount == 1, "one tab to start with")
    check(s.Query(".tab").Count == 1, "and the tab bar shows it")
    check(s.Page.FocusedElement === s.Query(".surface").First, "the terminal surface has the keyboard")
    let prompt = await until(5) { !c.ScreenText().allSatisfy { $0 == "\n" || $0 == " " } }
    check(prompt, "the shell drew a prompt")

    // Typing reaches the shell; what it runs reaches the screen.
    type(s, "echo vt-ok-$((6*7))")
    key(s, "Enter", "Enter")
    check(await until(5) { c.ScreenText().contains("vt-ok-42") }, "typed command ran (output on the screen)")

    // Pixels: the viewport draws, and the grid is sized to its box.
    _ = s.Pixels()
    let grid = c.GridSize
    check(grid.Columns > 40 && grid.Columns != 80, "the grid follows the view's size (\(grid.Columns)×\(grid.Rows))")
    type(s, "stty size")
    key(s, "Enter", "Enter")
    check(await until(5) { c.ScreenText().contains("\(grid.Rows) \(grid.Columns)") }, "and the shell was told (stty size)")

    // Control-C interrupts what runs in the foreground.
    type(s, "sleep 30")
    key(s, "Enter", "Enter")
    _ = await until(1) { false }
    key(s, "c", "KeyC", control: true)
    type(s, "echo after-$((1+1))")
    key(s, "Enter", "Enter")
    check(await until(5) { c.ScreenText().contains("after-2") }, "^C interrupted sleep")

    // A flood of output: 200,000 lines through the pty, the parser and
    // the scrollback, with frames drawn meanwhile.
    let t0 = time.Instant.Now()
    type(s, "seq 1 200000; echo flood-$((7*6))")
    key(s, "Enter", "Enter")
    let flooded = await until(30) {
        _ = s.Pixels()
        return c.ScreenText().contains("flood-42")
    }
    check(flooded, "200,000 lines of output arrive (\(t0.Elapsed().AsMilliseconds()) ms)")

    // Arrow keys: history.
    type(s, "echo again-$((2+2))")
    key(s, "Enter", "Enter")
    _ = await until(5) { c.ScreenText().contains("again-4") }
    key(s, "ArrowUp", "ArrowUp")
    key(s, "Enter", "Enter")
    check(await until(5) { count(c.ScreenText(), "again-4") >= 2 }, "↑ recalls the last command")

    // Dragging across the first row selects its text.
    type(s, "clear; echo select-me-please")
    key(s, "Enter", "Enter")
    _ = await until(5) { c.ScreenText().hasPrefix("select-me-please") || c.ScreenText().contains("\nselect-me-please") }
    _ = s.Pixels()
    let rowY: float32 = 15 / 466
    s.Drag(s.Query(".surface"), from: 0.005, to: 0.15, steps: 6, y: rowY)
    check(c.SelectedText().hasPrefix("select-me"), "a drag selects (\(c.SelectedText().debugDescription))")
    type(s, "x")
    check(c.SelectedText().isEmpty, "typing clears the selection")
    key(s, "Backspace", "Backspace")

    // With mouse reporting on, a press is the program's; Shift-drag still
    // selects.
    type(s, "clear; printf '\\033[?1000h'; echo mouse-on-ready")
    key(s, "Enter", "Enter")
    _ = await until(5) { c.ScreenText().contains("\nmouse-on-ready") || c.ScreenText().hasPrefix("mouse-on-ready") }
    _ = s.Pixels()
    let y: float32 = 36 + 6 + 8
    let shift = web.Modifiers(shift: true)
    _ = s.Page.Handle(.pointerDown(web.Pointer(draw.Point(8, y))))
    _ = s.Page.Handle(.pointerMoved(draw.Point(90, y)))
    _ = s.Page.Handle(.pointerUp(web.Pointer(draw.Point(90, y))))
    check(c.SelectedText().isEmpty, "a plain press goes to the program that asked for the mouse")
    _ = s.Page.Handle(.pointerDown(web.Pointer(draw.Point(8, y), modifiers: shift)))
    _ = s.Page.Handle(.pointerMoved(draw.Point(90, y)))
    _ = s.Page.Handle(.pointerUp(web.Pointer(draw.Point(90, y), modifiers: shift)))
    check(c.SelectedText().hasPrefix("mouse-on"), "Shift-drag selects anyway (\(c.SelectedText().debugDescription))")
    type(s, "printf '\\033[?1000l'")
    key(s, "Enter", "Enter")

    // The tab bar's + opens a tab, which comes to the front.
    check(s.Click(s.Query(".new")), "click +")
    check(c.TabCount == 2 && c.ActiveIndex == 1, "a second tab, in front")
    check(s.Query(".tab").Count == 2 && s.Query(".tab.active").Count == 1, "the bar shows two, one active")
    check(await until(5) { !c.ScreenText().allSatisfy { $0 == "\n" || $0 == " " } }, "its shell started")
    type(s, "printf '\\033]0;custom title\\007'")
    key(s, "Enter", "Enter")
    check(await until(5) { c.TabTitles.count == 2 && c.TabTitles[1] == "custom title" }, "OSC 0 sets the tab's title (\(c.TabTitles))")
    check(await until(2) { s.Query(".tab.active .label").Text == "custom title" }, "and the bar shows it")

    // ⌘1 and ⌘2 switch; clicking a tab switches.
    key(s, "1", "Digit1", meta: true)
    check(c.ActiveIndex == 0 && c.ScreenText().contains("mouse-on-ready"), "⌘1 shows the first tab")
    check(s.Click(s.Query(".tab").Nth(1)), "click the second tab")
    check(c.ActiveIndex == 1, "it comes to the front")
    check(s.Page.FocusedElement === s.Query(".surface").First, "and the keyboard stays with the terminal")

    // ⌘T, then ⌘W closes the tab in front.
    key(s, "t", "KeyT", meta: true)
    check(c.TabCount == 3, "⌘T opens a tab")
    key(s, "w", "KeyW", meta: true)
    check(c.TabCount == 2, "⌘W closes it")

    // Dialogs: quitting with two tabs asks; its buttons take clicks.
    c.RunAction("Terminal.Quit")
    _ = s.Pixels()
    check(c.DialogOpen, "quitting with two tabs asks first")
    check(s.Query(".dialog button").Count == 2, "with two buttons")
    check(s.Click(s.Query(".dialog button").Nth(1)), "click Cancel")
    check(!c.DialogOpen && c.TabCount == 2, "Cancel keeps the window")
    c.RunAction("Terminal.OpenAboutDialog")
    _ = s.Pixels()
    check(s.Click(s.Query(".dialog button")) && !c.DialogOpen, "the About dialog's OK closes it")

    // The ⌄ menu opens inside the window, and its items take clicks.
    check(s.Click(s.Query(".more")), "click ⌄")
    check(c.MenuLabels.contains("Command palette"), "the profiles menu opens (\(c.MenuLabels))")
    check(c.MenuX + 240 <= c.WindowWidth, "inside the window (x \(c.MenuX) of \(c.WindowWidth))")
    check(s.Click(s.ByText("About")) && c.DialogOpen, "a menu item takes a click")
    _ = s.Click(s.Query(".dialog button"))

    // Dragging a tab onto another moves it there.
    let firstTitle = c.TabTitles[0]
    s.Drag(s.Query(".tabs"), from: 0.1, to: 0.8, steps: 12, y: 0.5)
    check(c.TabTitles.count == 2 && c.TabTitles[1] == firstTitle, "dragging a tab reorders the tabs (\(c.TabTitles))")
    s.Drag(s.Query(".tabs"), from: 0.8, to: 0.1, steps: 12, y: 0.5)

    // Panes: ⌘D splits right; the new pane has focus and its own shell.
    key(s, "d", "KeyD", meta: true)
    _ = s.Pixels()
    check(c.PaneCount == 2 && c.FocusedPaneIndex == 1, "⌘D splits the pane (\(c.PaneCount) panes)")
    check(await until(5) { _ = s.Pixels(); return prompted(c) }, "both panes have a shell")
    type(s, "echo right-$((2*8))")
    key(s, "Enter", "Enter")
    check(await until(5) { c.PaneTexts()[1].contains("right-16") }, "typing goes to the focused pane")
    check(!c.PaneTexts()[0].contains("right-16"), "and not the other")
    key(s, "ArrowLeft", "ArrowLeft", meta: true, alt: true)
    check(c.FocusedPaneIndex == 0, "⌘⌥← moves focus left")
    c.RunAction("Terminal.ToggleBroadcastInput")
    check(c.Broadcasting, "broadcast input on")
    type(s, "echo both-$((3*3))")
    key(s, "Enter", "Enter")
    check(await until(5) { c.PaneTexts().allSatisfy { $0.contains("both-9") } }, "broadcast types into every pane")
    c.RunAction("Terminal.ToggleBroadcastInput")
    key(s, "y", "KeyY", meta: true, shift: true)
    check(c.Zoomed, "a user binding (⌘⇧Y) zooms the pane")
    key(s, "y", "KeyY", meta: true, shift: true)
    check(!c.Zoomed, "and back")
    key(s, "w", "KeyW", meta: true)
    check(c.PaneCount == 1, "⌘W closes the pane, not the tab (\(c.PaneCount))")

    // A user's action: sendInput on ⌘⇧U.
    key(s, "u", "KeyU", meta: true, shift: true)
    check(await until(5) { c.ScreenText().contains("sent-25") }, "a sendInput action types for you")

    // The command palette: filter, then run.
    key(s, "p", "KeyP", meta: true, shift: true)
    check(c.PaletteOpen, "⌘⇧P opens the command palette")
    type(s, "split pane right")
    check(c.PaletteLabels.first?.contains("Split pane") ?? false, "the palette filters (\(c.PaletteLabels.prefix(2)))")
    key(s, "Enter", "Enter")
    check(!c.PaletteOpen && c.PaneCount == 2, "Enter runs it: the pane splits")
    key(s, "w", "KeyW", meta: true)
    check(c.PaneCount == 1, "closed again")

    // Find.
    key(s, "f", "KeyF", meta: true)
    check(c.SearchOpen, "⌘F opens find")
    type(s, "sent-25")
    check(c.SearchMatches.Count >= 1, "it finds the text (\(c.SearchMatches.Count) matches)")
    key(s, "Escape", "Escape")
    check(!c.SearchOpen, "Escape closes it")

    // Actions from the settings: a scheme, a title, a color.
    c.RunAction("User.Scheme")
    check(c.ThemeName.hasPrefix("Test Scheme"), "setColorScheme uses the settings' scheme (\(c.ThemeName))")
    c.RunAction("User.Rename")
    check(c.TabTitles[c.ActiveIndex] == "My Tab", "renameTab")
    c.RunAction("User.Color")
    check(c.TabColors[c.ActiveIndex] == "#C50E1F", "setTabColor")
    check(s.Query(".tab.active .stripe").Count == 1, "and the tab shows it")

    // Read-only: typing doesn't reach the shell.
    c.RunAction("Terminal.ToggleReadOnlyMode")
    type(s, "echo nope-$((1+6))")
    key(s, "Enter", "Enter")
    _ = await until(1) { false }
    check(c.ReadOnly && !c.ScreenText().contains("nope-7"), "a read-only pane takes no input")
    c.RunAction("Terminal.ToggleReadOnlyMode")

    // The font size.
    let size = c.FontSize
    key(s, "=", "Equal", meta: true)
    check(c.FontSize == size + 1, "⌘= makes the font bigger")
    key(s, "0", "Digit0", meta: true)
    check(c.FontSize == size, "⌘0 resets it")

    // Mark mode.
    key(s, "m", "KeyM", meta: true, shift: true)
    check(c.InMarkMode, "⌘⇧M enters mark mode")
    key(s, "Escape", "Escape")
    check(!c.InMarkMode, "Escape leaves it")

    // Restoring a closed tab.
    key(s, "t", "KeyT", meta: true)
    let before = c.TabCount
    key(s, "w", "KeyW", meta: true)
    key(s, "t", "KeyT", meta: true, shift: true)
    check(c.TabCount == before, "⌘⇧T restores the closed tab")
    key(s, "w", "KeyW", meta: true)

    // The settings tab: ⌘, opens it beside the terminals.
    key(s, ",", "Comma", meta: true)
    check(c.SettingsTabShown && s.Query(".settings").Exists, "⌘, opens the settings tab")
    check(s.Query(".tab.settings-tab.active").Exists && s.Query(".tab.active").Count == 1, "it is the tab in front, and the only one")
    check(s.Query(".scontent h1").Text == "Startup", "on its first page")
    check(s.Click(s.ByText("Interaction")), "click a page in the sidebar")
    check(s.Query(".scontent h1").Text == "Interaction", "the page changes")
    let offBefore = s.Query(".switch.on").Count
    check(s.Click(s.ByText("Copy on select")), "click a switch's row")
    check(c.WrittenSettings.contains("\"copyOnSelect\": true"), "the change is written to settings.json")
    check(s.Query(".switch.on").Count == offBefore + 1, "and the switch shows it")
    s.Type(into: s.Query(".squery"), "tab width")
    check(s.Click(s.ByText("Tab width")), "click a choice")
    check(s.Query(".menu").Exists, "its options open as a menu")
    check(s.Click(s.ByText("Compact")), "pick one")
    check(s.Query(".tabbar.compact").Exists, "the tab bar takes it at once")
    s.Replace(in: s.Query(".squery"), "paste")
    check(s.Query(".scontent h1").Text == "Search results" && s.ByText("Large paste").Exists, "the search box finds settings on every page")
    s.Replace(in: s.Query(".squery"), "")
    check(s.Click(s.ByText("Defaults")) && s.Query(".scontent h1").Text == "Defaults", "the profiles' defaults")
    s.Replace(in: s.Query(".squery"), "history")
    check(s.Click(s.Query(".sstep").Nth(1)), "a number's +")
    check(c.WrittenSettings.contains("\"historySize\": 11000"), "writes the number under profiles.defaults")
    s.Replace(in: s.Query(".squery"), "")
    check(s.Click(s.ByText("Back to terminal")), "back to the terminal")
    check(!c.SettingsTabShown && c.SettingsTabOpen && !s.Query(".settings").Exists, "the terminal is in front; the settings tab stays")
    check(s.Page.FocusedElement === s.Query(".surface").First, "and the terminal has the keyboard")
    check(s.Click(s.Query(".settings-tab .close")), "close the settings tab")
    check(!c.SettingsTabOpen && !s.Query(".settings-tab").Exists, "it goes")

    // A shell that exits closes its tab.
    type(s, "exit")
    key(s, "Enter", "Enter")
    check(await until(5) { c.TabCount == 1 }, "exit closes the tab")
    check(s.Query(".tab").Count == 1, "and the bar drops it")

    // The close button.
    check(s.Click(s.Query(".tab .close")), "click ×")
    check(c.TabCount == 0, "the last tab closed (the app quits)")

    if failures > 0 {
        print("\(failures) failed")
        return 1
    }
    print("all ok")
    return 0
}
